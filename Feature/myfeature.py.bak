from __future__ import annotations

import argparse
import logging
from typing import Optional

logger = logging.getLogger(__name__)
_DEFAULT_FORMAT = "Hello, {name}!"


def greet(name: str, *, template: str = _DEFAULT_FORMAT) -> str:
    """
    Return a greeting for ``name`` using ``template``.

    The function validates the input and will raise a ``TypeError`` if
    ``name`` is not a string and a ``ValueError`` if the provided name
    is empty or only whitespace after stripping.

    :param name: The name to greet.
    :param template: A format string containing ``{name}`` where the name
                     should be inserted.
    :return: A greeting string.
    """
    if not isinstance(name, str):
        logger.debug("greet() received non-str type: %s", type(name))
        raise TypeError("`name` must be a string")

    cleaned = name.strip()
    if not cleaned:
        logger.debug("greet() received empty or whitespace-only name")
        raise ValueError("`name` must not be empty or whitespace")

    try:
        result = template.format(name=cleaned)
    except Exception as exc:  # pragma: no cover - defensive
        logger.exception("Invalid template passed to greet: %r", template)
        raise

    logger.debug("greet() -> %s", result)
    return result


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Simple greeter CLI")
    parser.add_argument("--name", "-n", help="Name to greet", default=None)
    parser.add_argument("--quiet", "-q", action="store_true", help="Suppress extra output")
    return parser


def main(argv: Optional[list[str]] = None) -> int:
    """CLI entrypoint for the greeting utility.

    If `--name` isn't provided, the user will be prompted for a name.
    Returns exit code 0 on success, non-zero otherwise.
    """
    logging.basicConfig(level=logging.INFO)
    parser = _build_parser()
    args = parser.parse_args(argv)

    name = args.name
    if name is None:
        try:
            name = input("Enter your name: ")
        except (EOFError, KeyboardInterrupt):
            logger.info("No name provided and input interrupted")
            return 2

    try:
        message = greet(name)
    except (TypeError, ValueError) as exc:
        logger.error("Invalid input: %s", exc)
        return 1

    print(message)
    if not args.quiet:
        print("Welcome to DevAsc")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
